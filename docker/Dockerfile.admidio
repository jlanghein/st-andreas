# Admidio with the German UI rewritten to the generic masculine.
#
# Build from the repository root so that tools/degender.py is in the context:
#   docker build -f docker/Dockerfile.admidio -t admidio-sta:v4.3.17 .
#
# The transform runs on whatever the pinned upstream image ships, so an
# Admidio update is a rebuild. A construct no rule covers fails this build.

ARG ADMIDIO_VERSION=v4.3.17
ARG PYTHON_VERSION=3.12-slim
ARG ADMIDIO_ROOT=/opt/app-root/src

FROM admidio/admidio:${ADMIDIO_VERSION} AS upstream

FROM python:${PYTHON_VERSION} AS transform
ARG ADMIDIO_ROOT
WORKDIR /languages
COPY --from=upstream ${ADMIDIO_ROOT}/adm_program/languages/de-DE.xml ./
COPY --from=upstream ${ADMIDIO_ROOT}/adm_program/languages/de.xml ./
COPY tools/degender.py /usr/local/bin/degender.py
RUN python3 /usr/local/bin/degender.py de-DE.xml de.xml

FROM admidio/admidio:${ADMIDIO_VERSION}
ARG ADMIDIO_ROOT
# startup.sh restores adm_program from provisioning/ whenever the directory is
# missing or empty, so both copies have to carry the patched wording.
COPY --from=transform --chown=www-data:root /languages/de-DE.xml /languages/de.xml \
     ${ADMIDIO_ROOT}/adm_program/languages/
COPY --from=transform --chown=www-data:root /languages/de-DE.xml /languages/de.xml \
     ${ADMIDIO_ROOT}/provisioning/adm_program/languages/
