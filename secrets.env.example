# Admidio Database Credentials (MariaDB on Hetzner Server)
ADMIDIO_DB_TYPE=mariadb
ADMIDIO_DB_HOST=db
ADMIDIO_DB_PORT=3306
ADMIDIO_DB_NAME=admidio
ADMIDIO_DB_USER=admidio
ADMIDIO_DB_PASSWORD=<your_db_password>
ADMIDIO_DB_ROOT_PASSWORD=<your_root_password>
ADMIDIO_TABLE_PREFIX=adm_

# Hetzner Server SSH Access
HETZNER_SSH_HOST=<server_ip>
HETZNER_SSH_USER=root
HETZNER_SSH_KEY_PATH=~/.ssh/hetzner_key

# Backup Configuration (optional)
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# SEPA Creditor Information (for Lastschrift)
SEPA_CREDITOR_NAME=<your_organization_name>
SEPA_CREDITOR_IBAN=<your_iban>
SEPA_CREDITOR_BIC=<your_bic>
SEPA_CREDITOR_ID=<your_sepa_creditor_id>

# SEPA Rücklastschriften (MT940 import)
STERNGELD_SMB_HOST=<smb_host>
STERNGELD_SMB_SHARE=<share_name>
STERNGELD_SMB_USER=<smb_user>
STERNGELD_SMB_PASSWORD=<smb_password>
STERNGELD_SMB_PATH=<folder_with_sta_exports>
SEPA_ACCOUNT_NUMBER=<account_number_as_in_field_25>
SEPA_BLZ=<bank_code_as_in_field_25>

# Returns report (optional; without it the summary stays in the log)
RETURNS_REPORT_TO=<treasurer_email>
SMTP_HOST=<smtp_host>
SMTP_PORT=587
SMTP_USER=<smtp_user>
SMTP_PASSWORD=<smtp_password>
SMTP_FROM=<sender_email>

# Returns schedule and ledger (optional)
RETURNS_SCHEDULE_HOUR=6
RETURNS_SCHEDULE_MINUTE=30
RETURNS_TIMEZONE=Europe/Berlin
RETURNS_LEDGER_PATH=./data/sepa_returns_ledger.json
